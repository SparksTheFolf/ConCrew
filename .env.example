SECRET_KEY=change-me-to-something-random

# Postgres. These POSTGRES_* values feed the "db" container in
# docker-compose.yml; DATABASE_URL is what Flask actually connects with.
# Use "localhost" here for local (non-Docker) runs -- the "web" service in
# docker-compose.yml overrides DATABASE_URL to use the "db" hostname
# instead, since that's how containers reach each other on the compose
# network. Leave DATABASE_URL unset instead to fall back to a local
# SQLite file under ./instance/volunteer.db.
POSTGRES_DB=volunteer
POSTGRES_USER=volunteer
POSTGRES_PASSWORD=change-me-to-something-random
DATABASE_URL=postgresql://volunteer:change-me-to-something-random@localhost:5432/volunteer

FLASK_APP=run.py
FLASK_ENV=production
APP_VERSION=Beta 2026.0.5.2
#APP_VERSION=Prod 2026.0.5.2

#Email settings
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Passwordless email login codes. All optional -- defaults shown.
#LOGIN_CODE_TTL_SECONDS=600
#LOGIN_CODE_RESEND_COOLDOWN_SECONDS=60
#LOGIN_CODE_MAX_ATTEMPTS=5